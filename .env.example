# GEMINI_API_KEY: Diperlukan untuk pemanggilan Gemini AI di sisi server (analisis keselarasan kurikulum & insight kebijakan).
# Diinjeksi otomatis oleh AI Studio atau dikonfigurasi pada Cloud Run Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / VITE_PUBLIC_URL: URL publik tempat web app di-hosting (mis. https://sinkron.bantenprov.go.id).
# VITE_PUBLIC_URL digunakan oleh generator tag og:image dan twitter:image. Jika kosong, fallback ke path relatif /og-image.png.
APP_URL="https://sinkron.bantenprov.go.id"
VITE_PUBLIC_URL="https://sinkron.bantenprov.go.id"

# PORT: Port server Express backend (bawaan: 3000)
PORT=3000

# NODE_ENV: Lingkungan ('development' atau 'production')
NODE_ENV="development"

# DEMO_MODE & VITE_DEMO_MODE:
# Mengaktifkan halaman /demo dan demonstrasi simulasi 9 peran bagi penilai/juri.
# PERINGATAN WAJIB: Kedua variabel ini WAJIB disetel 'false' saat aplikasi berjalan di produksi publik sungguhan.
DEMO_MODE="false"
VITE_DEMO_MODE="false"
